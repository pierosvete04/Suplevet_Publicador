# Credenciales del publicador de Suplevet. Va en la carpeta de datos como credenciales.env y NUNCA se sube a GitHub.
# Pega cada valor después del "="

# --- META (Instagram + Facebook + Ads) ---
# Con META_APP_ID y META_APP_SECRET basta para «Conectar con Facebook» (varias páginas e Instagram).
# Lo de abajo (token del usuario del sistema, página, Instagram y cuenta publicitaria) es opcional: lo usa la pauta.
META_APP_ID=
META_APP_SECRET=
META_TOKEN_USUARIO_SISTEMA=
META_PAGE_ID=
META_IG_USER_ID=
META_AD_ACCOUNT_ID=

# --- TIKTOK ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- GOOGLE / YOUTUBE ---
# El JSON que descargas de Google Cloud se guarda en esta misma carpeta como: google_client_secret.json

# Opcional: a dónde manda TikTok después de conectar (tiene que ser igual al de la app en developers.tiktok.com)
TIKTOK_REDIRECT_URI=
# Opcional: a dónde manda Facebook después de conectar (por defecto http://localhost:8766/oauth/meta)
META_REDIRECT_URI=
